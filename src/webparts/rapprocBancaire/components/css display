.ms-dlgTitle {padding: 10px 16px; border-bottom:1px solid #d35a1b}
.modal-footer {margin-left:auto;margin-right:auto;width:100px;}
.buttonPopUp {background-color: #D35A1B !important;border: none;color: white !important;text-align: center;text-decoration: none;display: inline-block;font-size: 16px !important;cursor: pointer;width:100px;}
.buttonPopUp:hover{background-color:rgba(240, 147, 96, 1);}
.modal-body p {text-align:center; font-size:16px;}

/* RESPONSIVE DESIGN */
@media screen and (max-width:1280px){
    #s4-workspace{position:absolute;left:0;right:0;}
    #s4-bodyContainer{margin:0 20px;width: calc(100% - 40px) !important;}
	/* Ancienne css qui coupait le contenu si trop large, notamment les list view webpart */
	/* #s4-workspace{position:absolute;overflow-x:hidden;left:0;right:0;}
    #s4-bodyContainer{width:inherit !important;display:block;margin:0 20px;} */
    .ms-core-overlay{width:inherit !important;min-width:320px;overflow-y:scroll;-webkit-overflow-scrolling:touch;}
	#contentBox{min-width:0px;width:calc(100% - 269px);margin:0;display:inline-block;}
	#contentRow{display:block;}
    #s4-titlerow{position:relative;}
    .recent-news-row{width:inherit;}
    #sideNavBox{display:inline-block;margin:0;}
	#WelcomeMessage{display:inherit;}
	
    /* Pictures */
    .ms-rtestate-field img{max-width:100% !important;}
    .Pictures{min-width:inherit;padding-top:0px;}
    .ms-core-listMenu-root ul{margin:0px;padding:0px;}

    /*Beezy overflow fix*/
    .popover.bz-webpart.popover--bottom-right,.drop.bz-webpart.drop-top{right:0;}
    .bz-webpart{overflow:hidden;}

	/* Table layout */
	.ms-webpart-chrome table{table-layout:fixed;}
	.ms-core-tableNoSpace > table,.ms-formtoolbar{table-layout:auto !important;}
	.ms-wpContentDivSpace{/*overflow-x:scroll;*/-webkit-overflow-scrolling:touch;}
	/* Excel,Form Fix */
	.ewa-grid-ltr table,.ms-toolbar table,table.ms-menutoolbar,.ms-webpart-chrome .ms-listviewtable{table-layout:auto;}
}

@media screen and (max-width:1050px){
	#s4-titlerow > .ms-verticalAlignTop{clear:both;}
	#s4-titlerow{padding-bottom:0;}
	.ms-srch-sb{float:none;}
	.ms-srch-sb>input{width:122px;}
    .ms-srch-sb > .ms-srch-sb-searchLink{float:right;margin:14px 4px;}
	.ms-mpSearchBox{position:absolute;width:auto;margin:0;right:0px;margin-top:-60px;}
    .ms-breadcrumb-box{width:auto;}
    #contentRow{padding-top:0;}

	/* Header FIX */
	#divSiteTitle{height:auto;}
	#titleAreaRow{padding-bottom: 10px;}
	#divSiteTitle,#divPageTitle{float:inherit;}
	#divPageTitle{line-height:1;}
	.ms-breadcrumb-box::after{content:"";height:50px;width:20px;position:absolute;background-color:#faf9f7;right:-20px;top:0px;}
	.ms-core-listMenu-horizontalBox li.static > .ms-core-listMenu-item{margin-right:20px;}
	
	#contentBox .information p{font-size:12px;text-align:left;}

	/* DispForm FIX */
	.ms-formtoolbar td:nth-child(2){width:auto;}

    /* Annonces */
	#contentBox .alert-display{width:auto !important;height:auto !important;}
	#contentBox .basic-slider{height:inherit;width:100% !important;margin-left:0px !important;}
	#contentBox #slider ul li{width:inherit;height:inherit;width:100%;border-bottom:1px solid #D8D8D8;}
	a.control_next{display:none;}
	#contentBox .alert .body{width:auto;max-height:inherit;position:relative;}

    /* SP Site feed */
    .ms-microfeed-fullMicrofeedDiv,.ms-microfeed-microblogpart,.ms-microfeed-feedPart,.ms-microfeed-replyArea,.ms-microfeed-rootText{min-width:auto;}
    .ms-microfeed-attachmentImage{width:100%;}

    /* Video */
    .video-content iframe{width:100%;}
    .recent-news,.all-news,.recent-videos{width:calc(50% - 21px);}
    .recent-news,.all-news,.recent-videos{-ms-flex-preferred-size:calc(-21px + 50%) !important;-ms-flex-positive:0;}
    .Pictures .Tile,.Documents.Tiles .Tile{width:calc(33.33% - 21px) !important;}
    .Pictures .Tile,.Documents.Tiles .Tile{-ms-flex-preferred-size:calc(-21px + 33.33%) !important;-ms-flex-positive:0;}
}


@media screen and (max-width:800px){
	#sideNavBox{width:180px;}

	/* Main */
    #s4-bodyContainer{overflow-x:unset;}
	.ms-webpart-chrome table.ms-listviewtable{table-layout:auto;}
	.ms-listviewtable{width:100%;}
	.ms-breadcrumb-box{width:100%;z-index:10;}

    /* Img */
	.information img,.ms-rtestate-field img,.ADSubject img{max-width:100%;}
	
	/* Title */
	#divPageTitle{line-height:inherit;}
	#pageTitle{font-size:20px;}
	.siteTitle{font-size:18px;line-height:16px;padding-top:15px;padding-right:90px;}
	.ms-webpart-titleText.ms-webpart-titleText,.ms-webpart-titleText{font-size:24px;}
	
	/* Top Menu */
	.ms-breadcrumb-box{min-height:45px;max-width:100%;}

	/* Ribbon */
	#suiteBar{display:none;}
	#suiteBar.showMenu{display:block;transition:opacity .15s ease-in-out;min-height:30px;}

	/* Search Box */
	.ms-mpSearchBox{transform:translateX(-200px);transition:transform .3s ease;left:0;right:inherit;margin-top:inherit;}
    .ms-mpSearchBox::before{display:none;}
	.ms-srch-sb>input{width:100px;}

	/* Search Results */
	.ms-srch-siteSearchResults{float:none;}
	#SearchBox,.ms-srch-sbLarge{width:100%;}
	.ms-srch-item-path{width:auto;}
	.ms-srch-item{width:auto;padding:10px 20Px;margin:0 -20px;}
	.ms-srch-sbLarge-navWidth{width:85%;}
	.ms-srch-item-body{display:block;}
	.ms-srch-hover-outerContainer{display:none !important;}
	.ms-srch-upscope-top{width:auto !important;}
	.ms-core-tableNoSpace,.ms-core-tableNoSpace > tbody,.ms-core-tableNoSpace > tbody > tr,.ms-core-tableNoSpace > tbody > tr > td{display:block !important;}
	.ms-webpart-zone{display:block;}
	#DeltaPlaceHolderMain .ms-srch-sbLarge{padding:6px;width:calc(100% - 14px);}
	.ms-srch-sbLarge > input{width:calc(100% - 60px);}
	.ms-webpart-cell-vertical{display:block!important;}
	.ms-webpart-chrome-vertical{display:block;}
	.ms-srch-group-content .recent-videos{margin-right:0;width:100%;margin-left:0;}
	
	/* Layout */
	#sideNavBox{transform:translateX(-100%);position:absolute;left:0;padding-right:20px;top:70px;}
	#contentRow{transition:transform .3s ease;margin-top:0px;}
	#contentBox{width:100%;}
	.ms-breadcrumb-box{width:auto;}
	body.showMenu .ms-mpSearchBox{transform:translateX(0);transition:transform .3s ease;}
	body.showMenu #contentRow{transform:translateX(200px);transition:transform .3s ease;}
	body.showMenu #contentBox div{pointer-events:none;}
	
	/* Responsive Menu */
	.responsiveButton{cursor:pointer;height:30px;width:30px;top:15px;background-position:center center;background-repeat:no-repeat;background-size:cover;position:absolute;;}
	.ms-dialog .responsiveButton{display:none;}
	.sidemenu.responsiveButton{bottom:-39px;background-image:url('../../Styles/img/responsive_MainMenu.png');right:20px;}
	.showRibbon.responsiveButton{background-image:url("../../Styles/img/ribbonsp.png");right:70px;}

	/* Language selector */
	#divAlternateLanguage{right:120px;}

	/* Surcharge / Ajustements */
	.bz-webpart .activity-message{float:left;width:100%;}
	
	/* Videos 100% */
    .recent-news,.all-news,.recent-videos{width:calc(100% - 21px);}
    .recent-news,.all-news,.recent-videos{-ms-flex-preferred-size:calc(-21px + 100%) !important;-ms-flex-positive:0;}
    .Pictures .Tile{width:calc(50% - 21px) !important;}
    .Pictures .Tile{-ms-flex-preferred-size:calc(-21px + 50%) !important;-ms-flex-positive:0;}
    .Pictures .Tile .Image{min-height:100px;height:auto;}
    .Pictures .Title{padding:10px;}

    /* Video page */
    #DeltaPlaceHolderMain > .ms-displayInlineBlock{min-width:inherit !important;}
    #DeltaPlaceHolderMain > .ms-displayInlineBlock  >   .ms-displayInlineBlock{width:inherit !important;}
    #DeltaPlaceHolderMain > .ms-displayInlineBlock .ms-webpart-chrome{width:inherit !important;}
    #DeltaPlaceHolderMain > .ms-displayInlineBlock .ms-WPBody{width:inherit !important;height:inherit !important;}
    #DeltaPlaceHolderMain > .ms-displayInlineBlock .mediaPlayerContainer video{width:100%;height:auto;}
	
	/* Information */
	#contentBox .information{padding:20px !important;}
	#contentBox .alert-info .body{margin-top:0;margin-right:0;}
	#contentBox .alert-info .header{margin-right:40px;}
	#iSlider a.control_next{top:20px;}
	
    /* Last documents */
    .Documents table .LastModified,.Documents table .Author{display:none;}
    .Documents.Tiles .Tile{width:calc(50% - 21px) !important;}
    .Documents.Tiles .Tile{-ms-flex-preferred-size:calc(-21px + 50%) !important;-ms-flex-positive:0;}
    .ms-pivotControl-surfacedOpt-selected::after{display:none;}
}

@media screen and (max-width:500px){
	/* Callouts */
	.js-callout-mainElement{left:0px !important;right:0px;bottom:0px !important;top:auto !important;}
	.js-callout-beakLeft{display:none;}
	.js-callout-content{width:auto !important;}
	
	#WelcomeBody {   padding: 10px;    background: #fff;}
	
	.DocButtons.Buttons {    display: table-caption;    text-align: right;    position: relative;    top: 0px;    width: 100%;}
	.DocButtons.Buttons .Button {    float: none;    display: inline-block;}
	.Documents.Table .Header{display:none;}
	.Documents.Table .Tile{width:auto;padding:10px;display:block;}
	.Documents.Table .Tile:nth-child(3){border-top:1px solid #c6c6c6;}
	.Documents .Icon::before{padding:3px 5px 3px 0px;font-size:14px;}
	.Documents.Table .Tile > div{display:block;width:inherit;min-width:inherit;border-left:none;}
	.Documents.Table .Tile > div:not(.Icon){padding:0;height:inherit;font-size:inherit;}
	.Documents.Table .Tile .Icon,.Documents.Table .Tile .Title{display:inline-block;}
}